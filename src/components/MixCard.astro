---
import {mixes} from '../data/collective';
interface Props {mix: (typeof mixes)[number]}
const {mix}=Astro.props;
---
<article class="mix-card reveal">
  <img src={mix.image} alt={`Cover-Artwork für ${mix.title}`} width="160" height="200" loading="lazy"/>
  <div>
    <span class="micro">F/A SELECTS — {mix.number}</span>
    <h3>{mix.title}</h3>
    <p>{mix.artist}</p>
    <span class="micro muted">{mix.mood}</span>
  </div>
  {mix.url ? <a href={mix.url} aria-label={`${mix.title} anhören`} class="mix-play">↗</a> : <span class="micro mix-soon">COMING<br/>SOON</span>}
</article>
