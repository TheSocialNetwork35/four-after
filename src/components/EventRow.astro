---
import type { CollectiveEvent } from "../data/collective";
interface Props {
  event: CollectiveEvent;
}
const { event } = Astro.props;
---

<article class="event-row reveal">
  <div class="event-date">
    <span>{event.day}</span><small>{event.month}</small>
  </div><div>
    <span class="micro">{event.label}</span><h3>{event.title}</h3>
  </div><p>{event.venue}<small>{event.city}</small></p>{
    event.ticketUrl ? (
      <a
        class="pill"
        href={event.ticketUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Tickets ↗
      </a>
    ) : (
      <span class="event-status">
        To be announced <span>↗</span>
      </span>
    )
  }
</article>
