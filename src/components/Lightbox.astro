<dialog
  id="lightbox"
  class="fullscreen-lightbox"
  aria-labelledby="lightbox-title"
>
  <div class="lightbox-top">
    <span class="micro" id="lightbox-count"></span><button
      class="dialog-close"
      aria-label="Galerie schließen"
    >
      Close ×
    </button>
  </div><div class="lightbox-stage">
    <img id="lightbox-image" alt="" width="1536" height="1536" />
  </div><div class="lightbox-footer">
    <button data-gallery-prev aria-label="Vorheriges Bild">←</button><h2
      id="lightbox-title"
    >
    </h2><button data-gallery-next aria-label="Nächstes Bild">→</button>
  </div>
</dialog>
