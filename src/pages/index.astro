---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import ArtistCard from "../components/ArtistCard.astro";
import SessionCard from "../components/SessionCard.astro";
import NextPage from "../components/NextPage.astro";
import PhotoNote from "../components/PhotoNote.astro";
import { artists } from "../data/collective";
import { sessions } from "../data/editorial";
---

<Layout
  ><main id="main">
    <section class="home-stage">
      <Photo
        asset="night"
        priority
        sizes="(max-width:650px) 1000px, 100vw"
        class="home-backdrop"
      /><div class="home-shade"></div><div class="home-eyebrow micro">
        <span>Independent DJ collective</span><span>
          Yannis / Cian / Maxim / Thierry
        </span>
      </div><h1 class="home-wordmark">
        <span>FOUR<span class="signal">/</span></span><span>AFTER</span>
      </h1><div class="home-stage-bottom">
        <p>Four minds.<br />One frequency.</p><a
          href="/collective/"
          class="text-link"
        >
          Enter our world <span>↗</span>
        </a><span class="micro">
          For the moments<br />that become the night.
        </span>
      </div><span class="hero-photo-label micro">
        Visual study / after dark
      </span>
    </section>
    <section class="home-intro paper-section page-pad">
      <span class="micro">01 / A SHARED FREQUENCY</span><div>
        <h2 class="reveal">
          Different minds.<br />The same <em>feeling.</em>
        </h2><p>
          Vier Perspektiven auf elektronische Musik. Verbunden durch die Suche
          nach diesem einen Moment, in dem aus einem Raum etwas Gemeinsames
          wird.
        </p><a class="text-link" href="/collective/">
          Meet the collective <span>↗</span>
        </a>
      </div><span class="intro-four" aria-hidden="true">04</span>
    </section>
    <section class="home-artists page-pad">
      <div class="editorial-heading">
        <span class="micro">02 / BEHIND THE SOUND</span><a
          class="text-link"
          href="/artists/"
        >
          All artists ↗
        </a>
      </div><div class="home-artist-row">
        {
          artists.map((artist, index) => (
            <ArtistCard artist={artist} index={index} />
          ))
        }
      </div><PhotoNote />
    </section>
    <section class="home-split">
      <a class="home-image-link" href="/events/">
        <Photo asset="space" /><div>
          <span class="micro">03 / UPCOMING CHAPTERS</span><h2>
            Meet us<br />there.
          </h2><span class="text-link">Events & nights ↗</span>
        </div>
      </a><div class="home-music paper-section">
        <span class="micro">04 / ON ROTATION</span><h2>
          Stay a<br />little longer.
        </h2><SessionCard session={sessions[0]} /><a
          href="/music/"
          class="text-link"
        >
          Explore the sound ↗
        </a>
      </div>
    </section>
    <section class="gallery-invitation page-pad">
      <span class="micro">05 / THE VISUAL JOURNAL</span><a
        href="/gallery/"
        class="gallery-invitation-link"
      >
        <h2>Some things<br />are better <em>felt.</em></h2><div
          class="invitation-photo"
        >
          <Photo asset="maxim" />
        </div><span class="big-arrow" aria-hidden="true">↗</span>
      </a><a class="text-link" href="/gallery/">Open the lookbook ↗</a>
    </section>
    <NextPage
      label="A club. A festival. A good idea."
      title="Let’s make a night."
      href="/booking/"
    />
  </main></Layout
>
