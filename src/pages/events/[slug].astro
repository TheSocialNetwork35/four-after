---
import Layout from "../../layouts/Layout.astro";
import Photo from "../../components/Photo.astro";
import NextPage from "../../components/NextPage.astro";
import PhotoNote from "../../components/PhotoNote.astro";
import { eventConcepts } from "../../data/editorial";
import { artists } from "../../data/collective";
export function getStaticPaths() {
  return eventConcepts.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}
const { event } = Astro.props;
---

<Layout title={`${event.title} — FOUR / AFTER Events`}
  ><main id="main">
    <section class="event-detail-hero">
      <Photo asset={event.photo} sizes="100vw" priority /><div>
        <a href="/events/" class="micro">← Events</a><span class="micro">
          {event.type} / {event.status}
        </span><h1>{event.title}</h1>
      </div>
    </section><section class="event-detail-body paper-section page-pad">
      <div>
        <span class="micro">THE IDEA</span><h2>
          A room.<br />A shared feeling.
        </h2><p>{event.description}</p>{
          event.ticketUrl ? (
            <a
              class="text-link"
              href={event.ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Tickets ↗
            </a>
          ) : (
            <p class="content-note">
              {event.date
                ? "Ticketinformationen folgen."
                : "Formatentwurf – noch keine bestätigte Veranstaltung. Keine Tickets im Verkauf."}
            </p>
          )
        }
      </div><dl>
        <div><dt>Datum</dt><dd>{event.date ?? "Wird angekündigt"}</dd></div><div
        >
          <dt>Venue</dt><dd>{event.venue ?? "Wird angekündigt"}</dd>
        </div><div>
          <dt>Ort</dt><dd>{event.city ?? "Wird angekündigt"}</dd>
        </div><div><dt>Format</dt><dd>{event.format}</dd></div>
      </dl>
    </section><section class="event-lineup page-pad">
      <span class="micro">THE COLLECTIVE</span><div>
        {
          artists.map((a) => (
            <a href={`/artists/${a.slug}/`}>
              {a.name}
              <span>↗</span>
            </a>
          ))
        }
      </div><PhotoNote />
    </section><NextPage title="Bring us to your room." href="/booking/" />
  </main></Layout
>
